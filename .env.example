# Copy to .env (never commit .env). Names only; put your own key after =.
GEMINI_API_KEY=
# The hiring manager signs in to the dashboard with these and is the only person who creates and deletes recruiters.
# Put your own values after the = (a long password); this file only names them.
HIRING_MANAGER_EMAIL=
HIRING_MANAGER_PASSWORD=
# The manager also takes calls, in this country (ES or MX; Spain if empty), Monday to Friday 9:00-17:00 unless they change it.
HIRING_MANAGER_COUNTRY=
# Live voice (D93): your own ElevenLabs key. The agent and its secret are made by python -m sazon.voice_launch.
ELEVENLABS_API_KEY=
# The voice id (ElevenLabs voices page). It must be in your own voices in ElevenLabs (add it from the library first); if you don't have a voice, leave it empty and the default will be used.
# ELEVENLABS_VOICE_ID=
# Optional: override the model if the default 404s (run: python -m sazon.chat --list-models)
# LLM_MODEL=
